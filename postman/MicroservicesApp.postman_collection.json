    {
      "name": "1. Gateway Ocelot (/apigateway)",
      "item": [
        {
          "name": "Products - Liste (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Tableau de produits', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const produits = pm.response.json();",
                  "if (produits.length > 0) {",
                  "    pm.collectionVariables.set('productId', produits[0].productId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/apigateway/Products",
              "host": ["{{gatewayUrl}}"],
              "path": ["apigateway", "Products"]
            },
            "description": "Route Ocelot -> GET https://localhost:7066/api/Products"
          },
          "response": []
        },
        {
          "name": "Products - Par id (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
