            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/apigateway/Products/{{productId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["apigateway", "Products", "{{productId}}"]
            },
            "description": "Route Ocelot -> GET https://localhost:7066/api/Products/{id}"
          },
          "response": []
        },
        {
          "name": "Products - Créer (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const produit = pm.response.json();",
                  "pm.test('Produit créé', () => pm.expect(produit.productId).to.be.a('number'));",
                  "pm.collectionVariables.set('productId', produit.productId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"prod12\",\n  \"stockQte\": 660,\n  \"price\": 1500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/apigateway/Products",
              "host": ["{{gatewayUrl}}"],
              "path": ["apigateway", "Products"]
            },
            "description": "Crée un produit via la gateway. ProductsAPI publie aussi ProductCreated dans RabbitMQ -> OrdersAPI l'enregistre dans sa table Products (si RabbitMQ tourne)."
          },
          "response": []
        },
        {
          "name": "Products - Modifier (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"name\": \"prod12\",\n  \"stockQte\": 700,\n  \"price\": 1600\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/apigateway/Products/{{productId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["apigateway", "Products", "{{productId}}"]
            },
            "description": "Le productId du body doit être identique à l'id de l'URL."
          },
          "response": []
