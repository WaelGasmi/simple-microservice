  },
  "variable": [
    { "key": "gatewayUrl", "value": "https://localhost:7162", "type": "string" },
    { "key": "productsApiUrl", "value": "https://localhost:7066", "type": "string" },
    { "key": "ordersApiUrl", "value": "https://localhost:7065", "type": "string" },
    { "key": "rabbitUrl", "value": "http://localhost:15672", "type": "string" },
    { "key": "rabbitUser", "value": "guest", "type": "string" },
    { "key": "rabbitPass", "value": "guest", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" }
  ],
